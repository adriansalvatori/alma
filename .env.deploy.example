# SSH targets for bin/deploy, bin/rollback, bin/pull and bin/backup.
#
# Copy to .env.deploy (gitignored) and fill in. One block per environment; the prefix is the
# environment name in capitals (bin/deploy staging reads STAGING_*). CI does not use this file:
# the deploy workflow passes the same values from GitHub Environment secrets as DEPLOY_*.

# Staging
STAGING_SSH_HOST=staging.example.com
STAGING_SSH_USER=alma
STAGING_SSH_PORT=22
# The deploy root on the server: releases/, shared/ and the current symlink live here.
STAGING_PATH=/home/alma/staging
# Used for the post-deploy health check (GET <URL>/api/health).
STAGING_URL=https://staging.example.com
# The WP-CLI binary on the server, if it is not plain `wp` on the PATH.
STAGING_WP=wp

# Production
PRODUCTION_SSH_HOST=example.com
PRODUCTION_SSH_USER=alma
PRODUCTION_SSH_PORT=22
PRODUCTION_PATH=/home/alma/production
PRODUCTION_URL=https://example.com
PRODUCTION_WP=wp

# Options bin/pull deletes after importing a remote database, so a local test cannot reach a
# live integration (space-separated option names, e.g. the lead webhook settings).
ALMA_PULL_SCRUB_OPTIONS=
