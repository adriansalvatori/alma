# =================================================================================================
# alma environment
#
# Copy to .env (bin/setup.sh does this for you and fills the secrets). On a server the file lives
# at <deploy root>/shared/.env and is linked into every release. Never commit a real .env.
#
# [required] must be set for the site to boot. Everything else has a safe default.
# Full reference (where each variable is read): web/app/themes/alma/docs/configuration.md
# =================================================================================================

# -------------------------------------------------------------------------------------------------
# WordPress / Bedrock
# -------------------------------------------------------------------------------------------------

# [required] development | staging | production. Unset means production.
WP_ENV='development'

# [required] The site URL, without a trailing slash. WP_SITEURL points at the /wp core directory.
WP_HOME='http://example.test'
WP_SITEURL="${WP_HOME}/wp"

# [required] Database. Or set DATABASE_URL='mysql://user:pass@host:3306/name' instead of these four.
DB_NAME='database_name'
DB_USER='database_user'
DB_PASSWORD='database_password'
DB_HOST='127.0.0.1'
# DB_PREFIX='wp_'
# DB_SSL=true

# [required] Salts. bin/setup.sh generates them; anything left as "generateme" is replaced.
AUTH_KEY='generateme'
SECURE_AUTH_KEY='generateme'
LOGGED_IN_KEY='generateme'
NONCE_KEY='generateme'
AUTH_SALT='generateme'
SECURE_AUTH_SALT='generateme'
LOGGED_IN_SALT='generateme'
NONCE_SALT='generateme'

# Production only: keep a not-yet-public production site out of search engines.
# (Non-production environments are always noindex.)
# DISALLOW_INDEXING=true

# Set to true only once a real cron runs WP-Cron (see docs/deployment.md, "Cron").
# DISABLE_WP_CRON=true

# WP_POST_REVISIONS=10
# WP_DEBUG_LOG='/absolute/path/outside/the/docroot/debug.log'

# -------------------------------------------------------------------------------------------------
# Application (Acorn)
# -------------------------------------------------------------------------------------------------

# [required] Encrypts 2FA secrets and signed values. bin/setup.sh generates it:
#   php -r 'echo "base64:".base64_encode(random_bytes(32)), PHP_EOL;'
# Changing it invalidates every stored 2FA secret.
APP_KEY=

# The running release. Leave unset: deploys write it into the release's .env.local.
# APP_VERSION=

# Comma-separated module keys to switch off here (content, seo, lead, account, commerce, payment).
ALMA_DISABLED_MODULES=

# sync (default) runs deferred work right after the response, with no worker. "database" puts it
# on the jobs table, drained by a cron: wp acorn queue:work --stop-when-empty --max-time=50
QUEUE_CONNECTION=sync

# file is right for shared hosting. Only use redis if the host provides it AND illuminate/redis
# is installed.
# CACHE_STORE=file
# SESSION_DRIVER=file

# Livewire wire:navigate (SPA-style page transitions on links).
WIRE_NAVIGATE=false

# ACF Pro license key: activates the plugin. Composer reads auth.json, not this (auth.json.example).
ACF_PRO_KEY=

# -------------------------------------------------------------------------------------------------
# Mail (SMTP). Without MAIL_HOST, WordPress falls back to PHP mail(), which shared hosts often
# drop or send to spam. Set this before launch.
# -------------------------------------------------------------------------------------------------

MAIL_HOST=
MAIL_PORT=587
# tls (STARTTLS on 587) or ssl (465)
MAIL_ENCRYPTION=tls
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# -------------------------------------------------------------------------------------------------
# Observability
# -------------------------------------------------------------------------------------------------

# Sentry: errors are only reported when a DSN is set. The release is APP_VERSION.
SENTRY_LARAVEL_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0.0
# SENTRY_SAMPLE_RATE=1.0
# SENTRY_ENVIRONMENT=        (defaults to WP_ENV)

# Unlocks the details of GET /api/health/checks (database, cron, failed jobs) for monitors; send it
# as the X-Health-Token header. Without it only logged-in administrators see details. GET
# /api/health is a public liveness probe that returns "ok" and the running version.
HEALTH_TOKEN=

# daily (default) keeps 14 days of web/app/cache/acorn/logs/laravel-YYYY-MM-DD.log
# LOG_CHANNEL=daily
# LOG_LEVEL=info
# LOG_DAILY_DAYS=14

# Health thresholds: cron is "behind" / "stalled" after this many seconds overdue.
# HEALTH_CRON_BEHIND_AFTER=900
# HEALTH_CRON_STALLED_AFTER=3600
# HEALTH_DB_SLOW_AFTER_MS=500
# HEALTH_FAILED_JOBS_WARN_AT=1

# Every outbound HTTP call (CRM webhooks, APIs) is logged to Tools → Integration log, redacted.
# INTEGRATION_LOG_ENABLED=true
# INTEGRATION_LOG_HOSTS=          (comma-separated allowlist; empty logs every host)
# INTEGRATION_LOG_RETENTION_DAYS=30

# -------------------------------------------------------------------------------------------------
# SEO (The SEO Framework settings live in config/seo.php and are applied on every deploy)
# -------------------------------------------------------------------------------------------------

# SEO_APPLY_ON_DEPLOY=true
# Add Disallow rules for AI training crawlers (GPTBot, CCBot, Google-Extended…) to robots.txt.
# SEO_BLOCK_AI_CRAWLERS=false

# -------------------------------------------------------------------------------------------------
# Leads (the Lead module). Recipients and the webhook can also be set in wp-admin → Leads → Settings.
# -------------------------------------------------------------------------------------------------

# Comma-separated addresses notified of each new lead.
LEAD_NOTIFICATION_RECIPIENTS=
# POST every new lead as signed JSON here (Zapier, Make, n8n, a CRM). Empty disables it.
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=
# LEAD_RETENTION_DAYS=365
# Outside production, notifications and the webhook only go to destinations set in THIS .env:
# the database is often a copy of production's (bin/pull). auto (default) | always | never.
# LEAD_DELIVERY=auto

# -------------------------------------------------------------------------------------------------
# Payments (the optional Payment module). Off unless enabled.
# -------------------------------------------------------------------------------------------------

PAYMENTS_ENABLED=false
# PAYMENTS_GATEWAY=fake
# PAYMENTS_CURRENCY=USD
# Signs the FakeGateway's local webhooks (non-production only). Any random string.
# PAYMENTS_FAKE_SECRET=

# -------------------------------------------------------------------------------------------------
# Commerce (the optional WooCommerce module; active only when WooCommerce is installed)
# -------------------------------------------------------------------------------------------------

# COMMERCE_FAVORITES_MAX=50
