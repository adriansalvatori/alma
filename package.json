{
  "name": "alma",
  "private": true,
  "description": "Convenience scripts. The front end lives in web/app/themes/alma; run npm install there (bin/setup.sh does).",
  "scripts": {
    "setup": "bash bin/setup.sh",
    "dev": "npm run dev --prefix web/app/themes/alma",
    "build": "npm run build --prefix web/app/themes/alma",
    "check": "composer check && npm run build",
    "translate": "npm run translate --prefix web/app/themes/alma",
    "deploy:staging": "bin/deploy staging",
    "deploy:production": "bin/deploy production",
    "backup": "bin/backup"
  }
}
