<?php

namespace DummyNamespace;

use App\Blocks\Concerns\HasRepeaterDefaults;
use Log1x\AcfComposer\Builder;

/**
 * Generated by `wp acorn acf:block` from stubs/acf-composer/block.stub, which follows the block
 * authoring contract (docs/blocks.md). Replace the example fields with the block's own, keep the
 * shape: DEFAULTS feeds both the field defaults and with().
 */
class DummyClass extends Block
{
    use HasRepeaterDefaults;

    public $name = 'DummyTitle';

    public $slug = 'DummySlug';

    public $description = 'DummyDescription';

    public $icon = 'block-default';

    public $keywords = [];

    /**
     * The only source of fallback copy. Each field's default_value points here.
     */
    public const DEFAULTS = [
        'heading' => 'DummyTitle',
        'intro' => '',
    ];

    /**
     * Preview data for the inserter.
     */
    public $example = [
        'heading' => 'DummyTitle',
    ];

    /**
     * Rows each repeater renders while empty, which the sidebar also loads.
     */
    public static function repeaterDefaults(): array
    {
        return [
            'items' => [
                ['title' => 'First item'],
                ['title' => 'Second item'],
            ],
        ];
    }

    public function with(): array
    {
        return [
            'heading' => $this->value('heading'),
            'intro' => $this->value('intro'),
            'items' => $this->rows('items'),
        ];
    }

    public function fields(): array
    {
        // The group is named after the slug so BlockMarkup can address the fields from patterns.
        $fields = Builder::make('DummySnake_block');

        $fields
            ->addText('heading', [
                'label' => 'Heading',
                'default_value' => self::DEFAULTS['heading'],
            ])
            ->addTextarea('intro', [
                'label' => 'Introduction',
                'instructions' => 'Leave empty for none.',
                'rows' => 2,
                'default_value' => self::DEFAULTS['intro'],
            ])
            // Links are text fields: ACF's URL field rejects /paths and #anchors.
            ->addRepeater('items', [
                'label' => 'Items',
                'layout' => 'block',
                'button_label' => 'Add item',
            ])
            ->addText('title', ['label' => 'Title'])
            ->endRepeater();

        return $fields->build();
    }
}
