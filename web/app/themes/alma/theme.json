{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": false,
    "layout": {
      "contentSize": "48rem",
      "wideSize": "80rem"
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "duotone": [],
      "gradients": [],
      "palette": [
        { "slug": "brand", "name": "Brand", "color": "oklch(0.511 0.262 276.966)" },
        { "slug": "ink", "name": "Ink", "color": "oklch(0.21 0.006 285.885)" },
        { "slug": "muted", "name": "Muted", "color": "oklch(0.552 0.016 285.938)" },
        { "slug": "white", "name": "White", "color": "#ffffff" }
      ]
    },
    "spacing": {
      "padding": false,
      "margin": false,
      "blockGap": false
    },
    "typography": {
      "customFontSize": false,
      "defaultFontSizes": false,
      "dropCap": false,
      "fontSizes": []
    }
  },
  "styles": {
    "elements": {
      "button": { "typography": { "textDecoration": "none" } },
      "link": { "typography": { "textDecoration": "none" } }
    }
  }
}
