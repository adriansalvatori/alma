{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "alma/cta-footer",
    "title": "CTA Footer",
    "category": "alma",
    "icon": "megaphone",
    "description": "A call to action section designed for the bottom of pages.",
    "attributes": {
        "title": {
            "type": "string",
            "default": "CTA Heading"
        },
        "description": {
            "type": "string",
            "default": "Reinforce the download offer, repeat your app's value, and include the app buttons again for one final push."
        },
        "primaryButtonText": {
            "type": "string",
            "default": "Download App"
        },
        "secondaryButtonText": {
            "type": "string",
            "default": "Download App"
        },
        "imageUrl": {
            "type": "string"
        }
    },
    "supports": {
        "align": [
            "wide",
            "full"
        ],
        "html": false,
        "jsx": true
    },
    "textdomain": "alma"
}