{
    "$schema": "https://schemas.wp.org/trunk/block.json",
    "apiVersion": 3,
    "name": "alma/features-grid",
    "title": "Features Grid",
    "category": "alma",
    "icon": "grid-view",
    "description": "A bento-style grid of highlighted features.",
    "attributes": {
        "sectionTitle": {
            "type": "string",
            "default": "Features Section"
        },
        "feature1Title": {
            "type": "string",
            "default": "Highlighted Feature 1"
        },
        "feature1Desc": {
            "type": "string",
            "default": "Use main feature cards with supporting visuals to quickly show how your app solves real problems."
        },
        "feature2Title": {
            "type": "string",
            "default": "Highlighted Feature 2"
        },
        "feature2Desc": {
            "type": "string",
            "default": "Brief explanation of the secondary feature."
        },
        "feature3Title": {
            "type": "string",
            "default": "Highlighted Feature 3"
        },
        "feature3Desc": {
            "type": "string",
            "default": "Brief explanation of the tertiary feature."
        }
    },
    "supports": {
        "align": [
            "wide",
            "full"
        ],
        "html": false,
        "jsx": true
    },
    "textdomain": "alma"
}