# Application
web/app/plugins/*
!web/app/plugins/.gitkeep
web/app/mu-plugins/*/
web/app/themes/twentytwentyfive/
web/app/upgrade
web/app/uploads/*
!web/app/uploads/.gitkeep
!web/app/uploads/.htaccess
web/app/cache/*

# WordPress (web/.htaccess is versioned: it carries the security rules for shared hosting)
web/wp

# Logs
*.log

# Dotenv
.env
.env.*
!.env.example
!.env.deploy.example

# Composer
/vendor
auth.json

# WP-CLI
wp-cli.local.yml

# OS / editors
.DS_Store
**/.DS_Store

# Database dumps and release artifacts (never commit these)
*.sql
*.sql.gz
/exports/
/releases/
/backups/

# Written by the deploy (the release being served)
/VERSION
*.zip
