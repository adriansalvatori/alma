{
  "name": "alma/alma",
  "type": "project",
  "license": "MIT",
  "description": "Alma v8: a WordPress + Laravel (Bedrock, Acorn, Livewire, ACF) boilerplate for marketing websites that deploys to shared hosting.",
  "keywords": [
    "wordpress",
    "bedrock",
    "acorn",
    "livewire",
    "boilerplate"
  ],
  "repositories": [
    {
      "name": "wpackagist",
      "type": "composer",
      "url": "https://wpackagist.org",
      "only": [
        "wpackagist-plugin/*",
        "wpackagist-theme/*"
      ]
    },
    {
      "name": "acf",
      "type": "composer",
      "url": "https://connect.advancedcustomfields.com",
      "only": [
        "wpengine/*"
      ]
    }
  ],
  "require": {
    "php": "^8.4",
    "composer/installers": "^2.3",
    "oscarotero/env": "^2.1",
    "roots/bedrock-autoloader": "^1.0",
    "roots/bedrock-disallow-indexing": "^2.0",
    "roots/wordpress": "^7.1",
    "roots/wp-config": "^1.0",
    "vlucas/phpdotenv": "^5.6",
    "wordpress/mcp-adapter": "^0.7",
    "wpackagist-plugin/autodescription": "^5.1",
    "wpengine/advanced-custom-fields-pro": "^6.8"
  },
  "require-dev": {
    "laravel/pint": "^1.32"
  },
  "suggest": {
    "wpackagist-plugin/woocommerce": "Enables the optional Commerce module (composer require wpackagist-plugin/woocommerce)."
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "automattic/jetpack-autoloader": true,
      "composer/installers": true,
      "roots/wordpress-core-installer": true
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "extra": {
    "installer-paths": {
      "web/app/mu-plugins/{$name}/": [
        "type:wordpress-muplugin"
      ],
      "web/app/plugins/{$name}/": [
        "type:wordpress-plugin"
      ],
      "web/app/themes/{$name}/": [
        "type:wordpress-theme"
      ]
    },
    "wordpress-install-dir": "web/wp"
  },
  "scripts": {
    "lint": "pint --test",
    "lint:fix": "pint",
    "theme": "@composer --working-dir=web/app/themes/alma",
    "check": [
      "@lint",
      "@composer --working-dir=web/app/themes/alma check"
    ],
    "post-create-project-cmd": [
      "bash bin/setup.sh"
    ]
  },
  "scripts-descriptions": {
    "lint": "Check formatting of the Bedrock files (the theme has its own Pint config).",
    "theme": "Run a composer command in the theme, e.g. composer theme test.",
    "check": "Everything CI runs, for the root and the theme."
  }
}
